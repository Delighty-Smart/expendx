rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Matches docs that carry a `user_id` field (transactions, budgets, alerts, ...)
    function isDataOwner() {
      return isAuthenticated() && (
        (resource != null && resource.data.user_id == request.auth.uid) ||
        (request.resource != null && request.resource.data.user_id == request.auth.uid)
      );
    }

    // Admin is derived from the caller's own user_profiles document
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Identity & preferences ─────────────────────────────────────────────
    match /user_profiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /user_settings/{userId} {
      allow read, write: if isOwner(userId) || isDataOwner() || isAdmin();
    }

    match /user_streaks/{userId} {
      allow read, write: if isOwner(userId) || isDataOwner() || isAdmin();
    }

    match /user_categories/{categoryId} {
      allow read, write: if isDataOwner() || isAdmin();
    }

    match /monthly_income_estimates/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /notification_preferences/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /push_subscriptions/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ─── Financial data ─────────────────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read, write: if isDataOwner() || isAdmin();
    }

    match /budget_categories/{budgetId} {
      allow read, write: if isDataOwner() || isAdmin();
    }

    match /savings_goals/{goalId} {
      allow read, write: if isDataOwner() || isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if isDataOwner() || isAdmin();
    }

    match /recurring_templates/{templateId} {
      allow read, write: if isDataOwner() || isAdmin();
    }

    match /alerts/{alertId} {
      allow read, write: if isDataOwner() || isAdmin();
    }

    // ─── Feedback ───────────────────────────────────────────────────────────
    match /user_feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin() || isDataOwner();
    }

    match /feedback_responses/{responseId} {
      allow read, write: if isAdmin();
    }

    // ─── Admin-managed content ──────────────────────────────────────────────
    match /admin_banners/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /slideshow_banners/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Fallback: deny everything else ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}